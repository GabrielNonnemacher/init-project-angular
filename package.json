{
  "name": "init-project-angular",
  "version": "0.1.0",
  "description": "CLI para iniciar projetos Angular com definições, padrões e skills para Cursor",
  "keywords": [
    "angular",
    "scaffold",
    "cli",
    "cursor",
    "starter",
    "template"
  ],
  "license": "MIT",
  "author": "",
  "type": "module",
  "bin": {
    "init-project-angular": "./dist/cli.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "check": "npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.5.0",
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "execa": "^9.5.2",
    "fs-extra": "^11.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^22.13.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "prettier": "^3.9.6",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
